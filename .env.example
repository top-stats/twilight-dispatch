# Logging level (tracing EnvFilter syntax, e.g. "info" or "info,twilight_gateway=debug")
RUST_LOG=info

# Discord bot token
BOT_TOKEN=

# Sharding information. Leave all three unset to run every shard Discord
# recommends (sessions are then not resumed across restarts).
SHARDS_START=0
SHARDS_END=1
SHARDS_TOTAL=2
# Optional upper bound for identify concurrency. Discord's max_concurrency
# (from GET /gateway/bot) is used when it is lower or when this is unset. A
# value that does not divide Discord's is lowered to the largest one that does
# (3 of 16 becomes 2), so shards Discord rate-limits together never identify
# together.
SHARDS_CONCURRENCY=1

# Declare the default gateway.recv queue bound to every event
DEFAULT_QUEUE=true

# Resume sessions after a restart
RESUME=true

# Identify payload. INTENTS accepts every intent Discord documents, including
# GUILD_MESSAGE_POLLS (1 << 24) and DIRECT_MESSAGE_POLLS (1 << 25).
INTENTS=32767
# 50 to 250
LARGE_THRESHOLD=250
STATUS=online
ACTIVITY_TYPE=0
ACTIVITY_NAME=Testing
# Optional. For ACTIVITY_TYPE=4 (custom status) the text is shown from the
# state, which defaults to ACTIVITY_NAME. ACTIVITY_URL is for streaming (1).
ACTIVITY_STATE=
ACTIVITY_URL=

# Discord channel logs (empty or 0 disables them)
LOG_CHANNEL=
LOG_GUILD_CHANNEL=

# State configuration (TTLs in milliseconds; 0 means never expire)
STATE_ENABLED=true
STATE_MEMBER=true
# A cached member is deleted this long after it was last written, so with a
# TTL the cache holds only the members seen recently (a members chunk or
# member event writes them again). Read a guild's size from member_count in
# guild:<id>, not by counting member keys; 0 keeps members until they leave.
# With 0, a member that a guild's GUILD_CREATE after a new session does not
# list (Discord leaves out offline members above LARGE_THRESHOLD members, and
# lists only the bot and voice users of a guild over 75k members) is deleted
# 24 hours later, unless a members chunk or member event writes it again first
# (at once when the GUILD_CREATE lists every member).
STATE_MEMBER_TTL=60000
STATE_MESSAGE=true
STATE_MESSAGE_TTL=60000
STATE_PRESENCE=true
STATE_EMOJI=true
STATE_VOICE=true
# Attach the previous cached value as "old" to published events
STATE_OLD=false

# AMQP broker (LavinMQ / RabbitMQ). Alternatively set AMQP_URL, e.g.
# amqp://user:pass@host:5672/%2f?heartbeat=30
# Keep heartbeat=30 in AMQP_URL (the URL built from RABBIT_* has it): without
# it LavinMQ's default of 300 s applies and a dead connection is noticed only
# after about 10 minutes.
RABBIT_HOST=127.0.0.1
RABBIT_PORT=5672
RABBIT_USERNAME=guest
RABBIT_PASSWORD=guest
RABBIT_VHOST=/
# Publisher confirms: an event counts as published (and the saved resume
# point may pass it) only once the broker confirmed it, so a broker crash
# cannot lose events. Off by default because, when on, each worker waits for
# one broker disk sync per event, which caps a guild at roughly 200 events/s
# (README, Operations).
# AMQP_CONFIRMS=true

# Redis. Alternatively set REDIS_URL, e.g. redis://:pass@host:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# Prometheus metrics and /healthcheck
PROMETHEUS_HOST=0.0.0.0
PROMETHEUS_PORT=8005

# Discord endpoints (optional; unset means Discord's own)
# Send REST requests to a proxy such as twilight-http-proxy instead of
# discord.com: http://host:port or https://host:port, without a path.
# DISCORD_API_PROXY=http://twilight-http-proxy:3000
# Connect new gateway sessions to a gateway proxy instead of
# wss://gateway.discord.gg: ws:// or wss://, a host, an optional port and
# path, no query or fragment (twilight appends
# /?v=10&encoding=json&compress=zstd-stream). Resumes still go to the
# resume URL Discord sent in READY.
# DISCORD_GATEWAY_URL=ws://gateway-proxy:7878

# Tuning (optional)
# Ordered workers that cache and publish events (events of one guild always
# use the same worker, so they stay in order). With AMQP_CONFIRMS each waits
# for the broker's confirm before its next event, so this bounds the publish
# rate: raise it (up to 1024) when shards log "Event queue is full" (README,
# Operations). Each worker buffers up to 1024 events, so memory grows with it.
WORKERS=32
# Time limit for one cache update; the event is still published without it
CACHE_TIMEOUT_MS=10000
# /healthcheck fails when a connected shard received nothing for this long
SHARD_SILENCE_SECS=180
